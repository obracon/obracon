# Supabase Configuration
# Copy this file to .env and fill in your project's details.
# These variables are loaded by Vite and made available in your client-side code.

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase project Anonymous Key (publicly safe to use in client-side code)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Example of other environment variables you might need:
# VITE_API_BASE_URL=/api
# VITE_APP_TITLE=My ERP Application
